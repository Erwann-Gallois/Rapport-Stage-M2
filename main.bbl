    \field{pages}{859\bibrangedash 883}
    \field{title}{Calculation of conformational ensembles from potentials of mean force. {An} approach to the knowledge-based prediction of local structures in globular proteins}
    \field{volume}{213}
    \field{journaltitle}{Journal of Molecular Biology}
    \field{month}{06}
