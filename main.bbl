    \verb 95/btac386.pdf
    \endverb
    \field{issn}{1367-4803}
    \field{number}{14}
    \field{pages}{3668\bibrangedash 3670}
    \field{title}{RNAsolo: a repository of cleaned PDB-derived RNA 3D structures}
    \verb{url}
