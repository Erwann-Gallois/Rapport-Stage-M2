    \verb .pdf
    \endverb
    \field{issn}{1362-4962}
    \field{number}{D1}
    \field{pages}{D564\bibrangedash D574}
    \field{title}{Updated resources for exploring experimentally-determined PDB structures and Computed Structure Models at the RCSB Protein Data Bank}
    \verb{url}
