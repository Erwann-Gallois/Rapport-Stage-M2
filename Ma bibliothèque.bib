	keywords = {Physics - Computational Physics, Physics - Biological Physics, Quantitative Biology - Biomolecules},
	file = {PDF:/home/erwann/Zotero/storage/ENUX7S2W/Rolls et al. - 2016 - Varying the resolution of the Rouse model on temporal and spatial scales application to multiscale.pdf:application/pdf},
}

