@article{liu_limited_1989,
	title = {On the limited memory {BFGS} method for large scale optimization},
	volume = {45},
	issn = {1436-4646},
	url = {https://doi.org/10.1007/BF01589116},
	doi = {10.1007/BF01589116},
	abstract = {We study the numerical performance of a limited memory quasi-Newton method for large scale optimization, which we call the L-BFGS method. We compare its performance with that of the method developed by Buckley and LeNir (1985), which combines cycles of BFGS steps and conjugate direction steps. Our numerical tests indicate that the L-BFGS method is faster than the method of Buckley and LeNir, and is better able to use additional storage to accelerate convergence. We show that the L-BFGS method can be greatly accelerated by means of a simple scaling. We then compare the L-BFGS method with the partitioned quasi-Newton method of Griewank and Toint (1982a). The results show that, for some problems, the partitioned quasi-Newton method is clearly superior to the L-BFGS method. However we find that for other problems the L-BFGS method is very competitive due to its low iteration cost. We also study the convergence properties of the L-BFGS method, and prove global convergence on uniformly convex problems.},
	number = {1},
	journal = {Mathematical Programming},
	author = {Liu, Dong C. and Nocedal, Jorge},
	month = aug,
	year = {1989},
	pages = {503--528},
}


@article{perry_arena_2023,
	title = {Arena: {Rapid} and {Accurate} {Reconstruction} of {Full} {Atomic} {RNA} {Structures} {From} {Coarse}-grained {Models}},
	volume = {435},
	issn = {0022-2836},
	shorttitle = {Arena},
	url = {https://www.sciencedirect.com/science/article/pii/S0022283623003091},
	doi = {10.1016/j.jmb.2023.168210},
	abstract = {RNA tertiary structures from experiments or computational predictions often contain missing atoms, which prevent analyses requiring full atomic structures. Current programs for RNA reconstruction can be slow, inaccurate, and/or require specific atoms to be present in the input. We present Arena (Atomic Reconstruction of RNA), which reconstructs a full atomic RNA structure from residues that can have as few as one atom. Arena first fills in missing atoms and then iteratively refines their placement to reduce nonideal geometries. We benchmarked Arena on a dataset of 361 RNA structures, where Arena achieves high accuracy and speed compared to other structure reconstruction programs. For example, Arena was used to reconstruct full atomic structures from a single phosphorus atom per nucleotide to, on average, within 3.63 Å RMSD of the experimental structure, while virtually removing all clashes and running in {\textless}3 s, which is 353× and 46× faster than state-of-the-art programs PDBFixer and C2A, respectively. The Arena source code is available at https://github.com/pylelab/Arena and the webserver at https://zhanggroup.org/Arena/.},
	number = {18},
	urldate = {2026-03-31},
	journal = {Journal of Molecular Biology},
	author = {Perry, Zion R. and Pyle, Anna Marie and Zhang, Chengxin},
	month = sep,
	year = {2023},
	keywords = {coarse-grained structure, full atomic reconstruction, RNA structure prediction, RNA tertiary structure, structure refinement},
	pages = {168210},
	file = {ScienceDirect Full Text PDF:/home/erwann/Zotero/storage/XCDPHJBL/Perry et al. - 2023 - Arena Rapid and Accurate Reconstruction of Full Atomic RNA Structures From Coarse-grained Models.pdf:application/pdf;ScienceDirect Snapshot:/home/erwann/Zotero/storage/BV56PW2X/S0022283623003091.html:text/html},
}


